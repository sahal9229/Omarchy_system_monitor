#!/usr/bin/env bash
# Focus existing Omarchy System Monitor window or launch a new instance if not running.
set -euo pipefail

APP_ID="org.omarchy.SystemMonitor"

# Check if the window is currently present in Hyprland
if command -v hyprctl &>/dev/null; then
    if hyprctl clients | grep -q "initialClass: ${APP_ID}"; then
        hyprctl dispatch focuswindow "class:${APP_ID}"
        exit 0
    fi
fi

# Fallback: Launch application (GApplication handles single-instance automatically)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -x "$SCRIPT_DIR/omarchy-sysmon" ]; then
    exec "$SCRIPT_DIR/omarchy-sysmon" "$@"
elif command -v omarchy-sysmon &>/dev/null; then
    exec omarchy-sysmon "$@"
else
    echo "Error: omarchy-sysmon executable not found." >&2
    exit 1
fi
